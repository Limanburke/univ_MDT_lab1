@model storeInfrastructure.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<h3>Sign in</h3>

<div asp-validation-summary="ModelOnly" style="color: red; margin-bottom: 15px;"></div>

<form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" style="max-width: 320px;">
    @Html.AntiForgeryToken()

    <div style="margin-bottom: 12px;">
        <label asp-for="Username"><strong>Username:</strong></label><br />
        <input asp-for="Username" style="width: 100%;" autofocus />
        <span asp-validation-for="Username" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 12px;">
        <label asp-for="Password"><strong>Password:</strong></label><br />
        <input asp-for="Password" style="width: 100%;" />
        <span asp-validation-for="Password" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 15px;">
        <label>
            <input asp-for="RememberMe" type="checkbox" /> Remember me
        </label>
    </div>

    <button type="submit">Sign in</button>
</form>