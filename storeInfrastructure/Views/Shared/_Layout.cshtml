<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Store System</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                margin: 20px 40px;
                color: #111;
                background-color: #fff;
                line-height: 1.4;
            }

            header {
                border-bottom: 2px solid #000;
                padding-bottom: 10px;
                margin-bottom: 20px;
            }

            nav a {
                margin-right: 15px;
                color: #000;
                text-decoration: underline;
                font-weight: bold;
            }

                nav a:hover {
                    color: #555;
                }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
                margin-bottom: 20px;
            }

            th, td {
                border: 1px solid #333;
                padding: 8px 10px;
                text-align: left;
            }

            th {
                background-color: #eee;
            }

            .notice {
                border: 1px solid #333;
                padding: 10px;
                margin-bottom: 15px;
                background-color: #f9f9f9;
            }

            input, button, select {
                font-family: inherit;
                padding: 4px 8px;
                border: 1px solid #333;
            }

            button {
                background-color: #eee;
                cursor: pointer;
            }

                button:hover {
                    background-color: #ddd;
                }

            footer {
                border-top: 1px solid #ccc;
                margin-top: 40px;
                padding-top: 10px;
                font-size: 0.9em;
                color: #555;
            }

            .user-auth-panel {
                float: right;
                font-size: 0.95em;
            }
    </style>
</head>
<body>
    <header>
        <h2>Store Management System</h2>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Inventory" asp-action="Index">Inventory</a>
            <a asp-controller="Inventory" asp-action="Products">Products</a>
            <a asp-controller="Sales" asp-action="Index">Sales</a>
            <a asp-controller="Employees" asp-action="Index">Employees</a>
            <a asp-controller="Inventory" asp-action="Audit">Audit Log</a>

            <span class="user-auth-panel">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>User: @User.Identity.Name (@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "No Role"))</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display: inline; margin-left: 10px;">
                        @Html.AntiForgeryToken()
                        <button type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </span>
            <div style="clear: both;"></div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>Store System - Modern Database Technologies (PostgreSQL)</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>